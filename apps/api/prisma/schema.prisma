generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Artist {
  id             Int      @id
  owner          String   @db.VarChar(42)
  metadataURI    String   @db.Text
  supporterCount Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  name  String? @db.Text
  photo String? @db.Text
  bio   String? @db.Text
  links Json?

  supporters Supporter[]
  pools      Pool[]

  @@map("artists")
}

model Supporter {
  id        Int      @id @default(autoincrement())
  artistId  Int
  address   String   @db.VarChar(42)
  rank      Int
  weight    Int
  signedAt  DateTime
  stakeWei  String   @db.VarChar(78)
  createdAt DateTime @default(now())

  artist Artist @relation(fields: [artistId], references: [id])

  @@unique([artistId, address])
  @@index([artistId, rank])
  @@index([address])
  @@map("supporters")
}

model Pool {
  id                Int       @id
  artistId          Int
  amountWei         String    @db.VarChar(78)
  milestoneHash     String    @db.VarChar(66)
  deadline          DateTime
  voteEnd           DateTime?
  supportersAtOpen  Int
  totalWeightAtOpen String    @db.VarChar(78)
  status            String    @db.VarChar(20)
  evidenceURI       String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  artist Artist @relation(fields: [artistId], references: [id])
  votes  Vote[]

  @@index([artistId, status])
  @@map("pools")
}

model Vote {
  id        Int      @id @default(autoincrement())
  poolId    Int
  address   String   @db.VarChar(42)
  approve   Boolean
  weight    String   @db.VarChar(78)
  votedAt   DateTime
  createdAt DateTime @default(now())

  pool Pool @relation(fields: [poolId], references: [id])

  @@unique([poolId, address])
  @@map("votes")
}

model IndexerCursor {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  lastBlock BigInt
  updatedAt DateTime @updatedAt

  @@map("indexer_cursors")
}
