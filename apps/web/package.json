{
  "name": "@cazatalentos/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "size": "size-limit"
  },
  "dependencies": {
    "@cazatalentos/shared": "workspace:*",
    "@fontsource/alfa-slab-one": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@privy-io/react-auth": "^3.46.0",
    "@privy-io/wagmi": "^4.0.17",
    "@tanstack/react-query": "^5.104.1",
    "embla-carousel-react": "8.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "viem": "^2.57.2",
    "wagmi": "^3.7.7",
    "zod": "^4.6.5"
  },
  "size-limit": [
    {
      "path": "dist/assets/entry-*.js",
      "limit": "200 kB",
      "gzip": true
    }
  ],
  "devDependencies": {
    "@size-limit/file": "^14.1.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "rollup-plugin-visualizer": "^7.1.1",
    "size-limit": "^14.1.0",
    "tailwindcss": "^3.4.19",
    "typescript": "6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
