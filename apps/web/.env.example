# App ID from Privy Dashboard → App settings → Basics → API keys.
# Use the App ID only — not the App Secret and not an App Client ID.
# Typical format: 25 alphanumeric chars (often starts with "cl" or "cm").
VITE_PRIVY_APP_ID=your_privy_app_id_here

VITE_CAZATALENTOS_ADDRESS=0x0000000000000000000000000000000000000000
VITE_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
VITE_API_URL=http://localhost:3001
